# ローカル専用。本番には別の資格情報を設定する。
BASIC_AUTH_USERNAME=recruit
BASIC_AUTH_PASSWORD=local-preview-only-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=local-admin-only-change-me
CONSULTATION_ENABLED=true
# localhost/127.0.0.1でのみTurnstileを省略。本番では必ずfalse。
LOCAL_FORM_TEST=true
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
# 返信はループバック限定で記録だけ行う（キーがあっても実送信しない）。
LOCAL_MAIL_TEST=true
REPLY_ENABLED=false
REPLY_FROM=
# 相談者がメールで返信した際の受信先。実際に受信できるメールアドレス。
REPLY_TO=
NOTIFICATION_FROM=
NOTIFICATION_TO=
DASHBOARD_URL=https://dashboard.okinawakaigo.com/
