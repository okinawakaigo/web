{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "okinawa-care-recruit",
  "account_id": "869d7f9f9faebf609a8363a4f9d9e38b",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "recruit.okinawakaigo.com", "custom_domain": true, "zone_id": "5569cc120a521fe8a69721914b75c648" }
  ],
  "assets": {
    "directory": "../recruit/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": false }
  // Optional D1 and rate limit bindings: see docs/deployment.md.
  // Account: Hidechika@okc2000.com's Account (okinawakaigo.com).
  // Configure Cloudflare Access for this hostname before enabling CI deployment.
  // Optional database bindings are configured separately.
}
