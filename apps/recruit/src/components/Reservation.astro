---
import { jobs, nextSteps } from '@okinawa-care/content';
import Button from '@okinawa-care/ui/Button.astro';
import Icon from '@okinawa-care/ui/Icon.astro';
import { reservation, hasReservation } from '../config';
---
<section id="reserve" class="reservation section" aria-labelledby="reserve-title">
  <div class="container reservation-grid">
    <div class="reservation-intro">
      <span class="reserve-label">あなたのペースで、一歩ずつ。</span>
      <h2 id="reserve-title">まずは、<br />話すところから。</h2>
      <p>「どんな人たちと働くの？」<br />「私の経験でも大丈夫？」<br />気になることを、そのまま聞かせてください。</p>
      <div class="reservation-note"><Icon name="people" size={22} /><span>説明会・職場見学についてご相談いただけます</span></div>
    </div>
    <div class="reservation-panel">
        <h3>説明会・見学のご希望を教えてください</h3>
        <p class="panel-description">{hasReservation ? '職種と次のステップを選ぶと、予約フォームへ進めます。' : '説明会・見学のお申し込みは、ただいま準備中です。'}</p>
        <form id="reservation-form" data-config={hasReservation ? JSON.stringify(reservation) : undefined}>
          <fieldset disabled={!hasReservation}>
          <label for="reservation-role">気になっている仕事</label>
          <select id="reservation-role" name="role"><option value="その他">相談して決めたい</option>{jobs.map(job => <option value={job.shortName}>{job.name}</option>)}</select>
          <label for="reservation-step">希望する次のステップ</label>
          <select id="reservation-step" name="step">{nextSteps.map(step => <option value={step.label}>{step.label}</option>)}</select>
          <button type="submit" class="reservation-submit">{hasReservation ? '予約フォームへ進む' : '受付準備中'}{hasReservation && <Icon />}</button>
          </fieldset>
          {hasReservation && <>
            <p class="form-notice">次の画面でお名前・連絡先をご入力ください。<br />この操作だけでは予約は完了しません。</p>
            <p id="reservation-error" role="alert" hidden>フォームを開けませんでした。<a href={reservation.url}>こちらから予約フォームを開いてください。</a></p>
          </>}
        </form>
        {hasReservation && <noscript><p>以下のリンクから予約フォームをご利用いただけます。</p><Button href={reservation.url}>予約フォームを開く</Button></noscript>}
    </div>
  </div>
</section>
<style>
  .reservation { background: var(--color-primary-dark); color: white; }
  .reservation-grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 10%; }
  .reserve-label { font-size: 14px; letter-spacing: .07em; color: #d2e5df; }
  .reservation-intro h2 { font: 500 clamp(38px, 4vw, 52px)/1.7 var(--font-display); letter-spacing: .08em; margin-top: 20px; }
  .reservation-intro > p { margin-top: 26px; font-size: 14px; line-height: 2.3; color: #e2eee8; }
  .reservation-note { display: flex; gap: 12px; margin-top: 38px; padding-top: 26px; border-top: 1px solid #39746b; align-items: center; font-size: 11px; color: #e2eee8; }
  .reservation-panel { background: white; color: var(--color-ink); border-radius: var(--radius-panel); padding: clamp(26px, 3.5vw, 48px); }
  .reservation-panel h3 { font-size: 18px; line-height: 1.9; }
  .form-notice { font-size: 10px; color: var(--color-muted); margin-top: 16px; line-height: 1.9; }
  .panel-description { font-size: 14px; color: var(--color-muted); margin-top: 10px; }
  form { margin-top: 24px; }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  label { display: block; font-size: 14px; font-weight: 600; margin: 18px 0 8px; }
  select { width: 100%; height: 52px; background: white; border: 1px solid #9aac9f; border-radius: 4px; padding: 0 12px; color: var(--color-ink); font-size: 14px; }
  .reservation-submit { display: flex; align-items: center; justify-content: space-between; border: 0; width: 100%; background: var(--color-primary); color: white; padding: 18px 20px; border-radius: 6px; font-size: 14px; font-weight: 500; margin-top: 24px; }
  .reservation-submit:enabled:hover { background: var(--color-primary-dark); }
  select:disabled, .reservation-submit:disabled { background: var(--color-mist); color: var(--color-muted); cursor: not-allowed; opacity: 1; }
  .reservation-submit:disabled { justify-content: center; }
  #reservation-error { font-size: 14px; color: #a53232; margin-top: 12px; }
  @media(max-width: 760px) { .reservation-grid { grid-template-columns: 1fr; gap: 40px; } .reservation-note { margin-top: 28px; } .reservation-intro h2 { font-size: 38px; } .reservation-panel { max-width: 540px; width: 100%; } }
</style>
