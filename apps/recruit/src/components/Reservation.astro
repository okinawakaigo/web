---
import { jobs, nextSteps } from "@okinawa-care/content";
import Button from "@okinawa-care/ui/Button.astro";
import SelectField from "@okinawa-care/ui/SelectField.astro";
import Icon from "@okinawa-care/ui/Icon.astro";
import { reservation, hasReservation } from "../config";
---

<section
  id="reserve"
  class="reservation section"
  aria-labelledby="reserve-title"
>
  <div class="content-container reservation-grid">
    <div class="reservation-intro">
      <span class="reserve-label">あなたのペースで、一歩ずつ。</span>
      <h2 id="reserve-title">まずは、<br />話すところから。</h2>
      <p>
        「どんな人たちと働くの？」<br />「私の経験でも大丈夫？」<br
        />気になることを、そのまま聞かせてください。
      </p>
      <div class="reservation-note">
        <Icon name="people" size={22} /><span
          >説明会・職場見学についてご相談いただけます</span>
      </div>
    </div>
    <div class="reservation-panel">
      <h3>説明会・見学のご希望を教えてください</h3>
      <p class="panel-description">
        {
          hasReservation
            ? "職種と次のステップを選ぶと、予約フォームへ進めます。"
            : "説明会・見学のお申し込みは、ただいま準備中です。"
        }
      </p>
      <form
        id="reservation-form"
        data-config={hasReservation ? JSON.stringify(reservation) : undefined}
      >
        <fieldset disabled={!hasReservation}>
          <SelectField
            id="reservation-role"
            name="role"
            label="気になっている仕事"
            ><option value="その他">相談して決めたい</option>{
              jobs.map((job) => (
                <option value={job.shortName}>{job.name}</option>
              ))
            }</SelectField
          >
          <SelectField
            id="reservation-step"
            name="step"
            label="希望する次のステップ"
            >{
              nextSteps.map((step) => (
                <option value={step.label}>{step.label}</option>
              ))
            }</SelectField
          >
          <Button
            as="button"
            type="submit"
            class="w-full mt-6"
            disabled={!hasReservation}
            icon={hasReservation ? "arrow" : false}
            >{hasReservation ? "予約フォームへ進む" : "受付準備中"}</Button
          >
        </fieldset>
        {
          hasReservation && (
            <>
              <p class="form-notice">
                次の画面でお名前・連絡先をご入力ください。
                <br />
                この操作だけでは予約は完了しません。
              </p>
              <p id="reservation-error" class="field-error" role="alert" hidden>
                フォームを開けませんでした。
                <a href={reservation.url}>
                  こちらから予約フォームを開いてください。
                </a>
              </p>
            </>
          )
        }
      </form>
      {
        hasReservation && (
          <noscript>
            <>
              <p>以下のリンクから予約フォームをご利用いただけます。</p>
              <Button href={reservation.url}>予約フォームを開く</Button>
            </>
          </noscript>
        )
      }
    </div>
  </div>
</section>
<style>
  @reference "@okinawa-care/ui/styles.css";
  @layer components {
    .reservation {
      @apply bg-primary-dark text-paper;
    }
    .reservation-grid {
      @apply grid grid-cols-2 items-center;
      gap: 10%;
    }
    .reserve-label {
      @apply text-body tracking-wide text-inverse-muted;
    }
    .reservation-intro h2 {
      @apply font-medium text-reserve font-display leading-heading tracking-wide mt-5;
    }
    .reservation-intro > p {
      @apply mt-7 text-body leading-prose text-inverse-muted;
    }
    .reservation-note {
      @apply flex gap-3 mt-10 pt-7 border-t border-solid border-inverse-line items-center text-caption text-inverse-muted;
    }
    .reservation-panel {
      @apply bg-paper text-ink rounded-panel p-panel;
    }
    .reservation-panel h3 {
      @apply text-subtitle leading-body;
    }
    .form-notice {
      @apply text-micro text-muted mt-4 leading-body;
    }
    .panel-description {
      @apply text-body text-muted mt-3;
    }
    form {
      @apply mt-6;
    }
    fieldset {
      @apply border-0 p-0 m-0 min-w-0;
    }
    @media (width < theme(--breakpoint-md)) {
      .reservation-grid {
        @apply grid-cols-1 gap-10;
      }
      .reservation-note {
        @apply mt-7;
      }
      .reservation-intro h2 {
        @apply text-reserve-mobile;
      }
      .reservation-panel {
        @apply max-w-form w-full;
      }
    }
  }
</style>
