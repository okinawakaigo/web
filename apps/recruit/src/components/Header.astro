---
import Brand from "@okinawa-care/ui/Brand.astro";
import Button from "@okinawa-care/ui/Button.astro";
const home = Astro.url.pathname === "/" ? "" : "/";
---

<header class="site-header">
  <div class="header-inner">
    <div class="header-brand">
      <Brand /><span class="recruit-label">採用サイト</span>
    </div>
    <nav aria-label="メインナビゲーション" class="desktop-nav">
      <a href={`${home}#about`}>私たちについて</a><a href={`${home}#workplace`}
        >働く環境</a
      ><a href={`${home}#jobs`}>仕事を知る</a>
    </nav>
    <Button class="header-cta" href={`${home}#reserve`}
      >説明会・見学の相談</Button
    >
    <button
      class="menu-toggle"
      aria-controls="mobile-navigation"
      aria-expanded="false"
      hidden
      ><span class="menu-lines" aria-hidden="true"></span><span
        class="menu-label">メニュー</span
      ></button
    >
  </div>
  <nav
    id="mobile-navigation"
    class="mobile-nav"
    aria-label="モバイルナビゲーション"
    hidden
  >
    <a href={`${home}#about`}>私たちについて</a><a href={`${home}#workplace`}
      >働く環境</a
    ><a href={`${home}#jobs`}>仕事を知る</a><a href={`${home}#faq`}
      >よくある質問</a
    ><a href={`${home}#reserve`}>説明会・見学の相談</a>
  </nav>
</header>
<style>
  @reference "@okinawa-care/ui/styles.css";
  @layer components {
    .site-header {
      @apply sticky bg-paper/97 border-b border-solid border-mist;
      top: 0;
      z-index: 20;
    }
    .header-inner {
      @apply flex items-center gap-8 px-header-gutter max-w-wide m-auto;
      min-height: 96px;
    }
    .header-brand {
      @apply flex items-center gap-6 mr-auto;
    }
    .recruit-label {
      @apply text-caption border-l border-solid border-line pl-6 whitespace-nowrap;
    }
    .desktop-nav {
      @apply flex gap-7;
    }
    .desktop-nav a {
      @apply text-label font-medium no-underline;
    }
    .desktop-nav a:hover {
      @apply text-primary;
    }
    .menu-toggle {
      @apply hidden border-0 bg-transparent p-2;
      min-width: 48px;
      min-height: 48px;
    }
    .menu-label {
      @apply block text-micro mt-1;
    }
    .menu-lines {
      @apply block mx-auto;
      width: 22px;
      height: 12px;
      border-block: 1.5px solid var(--color-primary);
    }
    .menu-toggle[aria-expanded="true"] .menu-lines {
      @apply border-b-0;
      transform: rotate(-45deg);
      height: 0;
    }
    .mobile-nav {
      @apply border-t border-solid border-line pt-3 px-6 pb-6;
    }
    .mobile-nav a {
      @apply block py-3 px-0 no-underline border-b border-solid border-line text-body;
    }
    @media (width < theme(--breakpoint-lg)) {
      .recruit-label {
        @apply hidden;
      }
      .header-inner {
        @apply gap-6;
      }
      .desktop-nav {
        @apply gap-5;
      }
    }
    @media (width < theme(--breakpoint-nav)) {
      .desktop-nav {
        @apply hidden;
      }
      .menu-toggle {
        @apply block;
      }
      .header-inner {
        @apply gap-3;
        min-height: 80px;
      }
    }
    @media (width < theme(--breakpoint-sm)) {
      .header-inner {
        @apply px-5;
        min-height: 76px;
      }
      .site-header :global(.header-cta) {
        @apply hidden;
      }
    }
  }
</style>
<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const menu = document.querySelector<HTMLElement>("#mobile-navigation");
  if (toggle && menu) {
    toggle.hidden = false;
    const closeMenu = () => {
      menu.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
    };
    toggle.addEventListener("click", () => {
      const opening = toggle.getAttribute("aria-expanded") !== "true";
      menu.hidden = !opening;
      toggle.setAttribute("aria-expanded", String(opening));
    });
    menu
      .querySelectorAll("a")
      .forEach((link) => link.addEventListener("click", closeMenu));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hidden) {
        closeMenu();
        toggle.focus();
      }
    });
    const navBreakpoint = getComputedStyle(document.documentElement)
      .getPropertyValue("--breakpoint-nav")
      .trim();
    matchMedia(`(min-width: ${navBreakpoint})`).addEventListener(
      "change",
      closeMenu,
    );
  }
</script>
