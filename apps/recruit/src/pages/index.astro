---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Reservation from "../components/Reservation.astro";
import Button from "@okinawa-care/ui/Button.astro";
import Icon from "@okinawa-care/ui/Icon.astro";
import { jobs, benefits, faqs, company } from "@okinawa-care/content";
import care from "../assets/care.jpg";
import ocean from "../assets/okinawa.jpg";
import "../styles/recruit.css";
---

<Layout>
  <Header />
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="content-container hero-grid">
        <div class="hero-copy">
          <p class="hero-location">
            <Icon name="pin" size={15} />沖縄・那覇で、介護の仕事。
          </p>
          <h1 id="hero-title">
            誰かの毎日も、<br />あなたの毎日も、<br />大切に。
          </h1>
          <p class="hero-description">
            その人らしい暮らしを支えるには、<br />働く私たちも、自分らしく。<br
            />この島で、これからの働き方を見つけませんか。
          </p>
          <div class="hero-actions">
            <Button href="#reserve">説明会・見学の相談</Button><a
              href="#jobs"
              class="hero-jobs-link"
              ><span>仕事を知る</span><Icon name="arrow" size={19} /></a>
          </div>
          <p class="hero-recruitment">
            訪問介護員・ケアマネジャー・相談支援専門員
          </p>
        </div>
        <div class="hero-visual">
          <figure class="hero-photo">
            <Image
              src={care}
              alt="緑のある屋外で笑顔を交わす介護職と高齢の女性。介護のイメージ写真"
              width={720}
              height={800}
              widths={[360, 540, 720]}
              sizes="(max-width: 760px) calc(100vw - 48px), 45vw"
              fit="cover"
              loading="eager"
              fetchpriority="high"
              quality={85}
            /><figcaption>写真はイメージです</figcaption>
          </figure>
          <div class="hero-image-note">
            <span class="note-line" aria-hidden="true"></span><span
              >人を想う。<br />自分も、大切にする。</span>
          </div>
          <div class="hero-place">Okinawa, our home.</div>
        </div>
      </div>
      <div class="hero-bottom content-container">
        <span>あなたの「想い」を支えます</span><a href="#about"
          >私たちのこと <span class="scroll-line" aria-hidden="true"></span></a>
      </div>
    </section>

    <section id="about" class="about section" aria-labelledby="about-title">
      <div class="content-container about-grid">
        <div class="about-image">
          <Image
            src={ocean}
            alt="青緑の海と緑の海岸が広がる沖縄の風景"
            widths={[480, 800, 1100]}
            sizes="(max-width: 760px) 100vw, 45vw"
            width={1100}
            height={950}
            fit="cover"
            loading="lazy"
          /><span class="image-place">この島の、いつもの暮らしのそばに。</span>
        </div>
        <div class="about-copy">
          <p class="section-label">私たちについて</p><h2
            id="about-title"
            class="section-heading"
          >
            大切にしたいのは、<br />暮らしの、その先。
          </h2><p>
            住み慣れた家で過ごしたい。<br
            />好きな場所へ、もう一度出かけたい。<br
            />私たちの仕事は、その想いを聞くことから始まります。
          </p><p>
            沖縄介護センターは、那覇市松川を拠点に、<br
              class="desktop-break"
            />訪問介護や居宅介護支援、障がい福祉、<br
              class="desktop-break"
            />そして旅行の付き添いまで、暮らしを支えてきました。
          </p><p>
            利用者さまの毎日を大切にするように、<br
            />一緒に働く仲間の毎日も、大切にしていきたい。<br
            />それが、私たちの目指す職場です。
          </p><a class="text-link" href="#workplace"
            >働く環境を見てみる <Icon /></a>
        </div>
      </div>
    </section>

    <section
      id="workplace"
      class="workplace section"
      aria-labelledby="workplace-title"
    >
      <div class="content-container">
        <div class="section-intro">
          <div>
            <p class="section-label">働く環境</p><h2
              id="workplace-title"
              class="section-heading"
            >
              支える人にも、<br />支えのある職場を。
            </h2>
          </div><p>
            気持ちだけに頼らず、仕組みで支える。<br
            />安心して仕事に向き合える環境づくりを、<br />一つずつ進めています。
          </p>
        </div>
        <div class="benefits">
          {
            benefits.map((benefit) => (
              <article class="benefit">
                <>
                  <div class="benefit-icon">
                    <Icon name={benefit.icon} size={34} />
                  </div>
                  <h3>{benefit.title}</h3>
                  <p>{benefit.description}</p>
                </>
              </article>
            ))
          }
        </div>
        <p class="workplace-note">
          制度の適用条件や研修の内容は、説明会・ご相談時にご案内します。
        </p>
      </div>
    </section>

    <section id="jobs" class="jobs section" aria-labelledby="jobs-title">
      <div class="content-container">
        <div class="section-intro">
          <div>
            <p class="section-label">仕事を知る</p><h2
              id="jobs-title"
              class="section-heading"
            >
              あなたの力が、<br />誰かの暮らしにつながる。
            </h2>
          </div><p>
            得意なことも、これから学びたいことも。<br
            />それぞれの専門性を持ち寄って、<br />地域の暮らしを一緒に支えます。
          </p>
        </div>
        <div class="job-list">
          {
            jobs.map((job, index) => (
              <details
                class="job"
                name="jobs"
                open={index === 0}
                id={`job-${job.id}`}
              >
                <>
                  <summary>
                    <>
                      <span class="job-category">{job.category}</span>
                      <h3>{job.name}</h3>
                      <span class="job-toggle">
                        <>
                          <Icon name="plus" size={21} />
                          <span class="sr-only">仕事内容の開閉</span>
                        </>
                      </span>
                    </>
                  </summary>
                  <div class="job-content">
                    <>
                      <p class="job-description">{job.description}</p>
                      <div class="job-columns">
                        <>
                          <div>
                            <>
                              <h4>主な仕事</h4>
                              <ul>
                                {job.duties.map((duty) => (
                                  <li>{duty}</li>
                                ))}
                              </ul>
                            </>
                          </div>
                          <div>
                            <>
                              <h4>資格・経験について</h4>
                              <p>{job.qualification}</p>
                            </>
                          </div>
                        </>
                      </div>
                      <div class="job-bottom">
                        <>
                          <p>{job.note}</p>
                          <Button
                            href="#reserve"
                            variant="outline"
                            data-role={job.shortName}
                          >
                            この仕事について相談する
                          </Button>
                        </>
                      </div>
                    </>
                  </div>
                </>
              </details>
            ))
          }
        </div>
        <aside class="conditions-note">
          <span>募集条件について</span><p>
            給与・手当・勤務時間・休日などは、職種や勤務形態によって異なります。<br
            />最新の募集状況と条件を、お問い合わせ時にご案内します。
          </p>
        </aside>
      </div>
    </section>

    <section class="possibility" aria-labelledby="possibility-title">
      <div class="content-container possibility-grid">
        <div class="possibility-title">
          <span class="possibility-small">暮らしの先にある、楽しみも。</span><h2
            id="possibility-title"
          >
            「行ってみたい」も、<br />支える仕事。
          </h2>
        </div><div>
          <p>
            介護が必要になっても、旅を楽しんでほしい。<br
            />旅行の付き添いや観光介護タクシーも、<br
            />沖縄介護センターが届けている支援の一つです。
          </p><a href="#reserve" class="text-link"
            >旅行の付き添いについて聞く <Icon /></a>
        </div>
      </div>
    </section>

    <section class="daily section" aria-labelledby="daily-title">
      <div class="content-container daily-grid">
        <div>
          <p class="section-label">もっと、私たちを知る</p><h2
            id="daily-title"
            class="section-heading"
          >
            ふだんの姿にも、<br />私たちらしさ。
          </h2><p>
            言葉だけでは伝えきれない、日々の活動。<br
            />沖縄介護センターのInstagramでも<br />ご紹介しています。
          </p>
        </div><a
          class="instagram-panel"
          href={company.instagram}
          target="_blank"
          rel="noopener noreferrer"
          ><span class="instagram-top"
            ><Icon name="instagram" size={30} /><Icon
              name="external"
              size={19}
            /></span
          ><span class="instagram-account">@okinawakaigo</span><span
            class="instagram-description">沖縄介護センターの日々を見てみる</span
          ><span class="instagram-bottom">Instagram <Icon size={19} /></span
          ></a>
      </div>
    </section>

    <section id="faq" class="faq section" aria-labelledby="faq-title">
      <div class="content-container faq-grid">
        <div>
          <p class="section-label">よくある質問</p><h2
            id="faq-title"
            class="section-heading"
          >
            気になることを、<br />ひとつずつ。
          </h2>
        </div><div class="faq-list">
          {
            faqs.map((faq) => (
              <details class="faq-item">
                <>
                  <summary>
                    <>
                      <span class="question-mark" aria-hidden="true">
                        Q.
                      </span>
                      <span>{faq.question}</span>
                      <Icon name="plus" size={18} />
                    </>
                  </summary>
                  <p>{faq.answer}</p>
                </>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <Reservation />

    <section class="company section" aria-labelledby="company-title">
      <div class="content-container company-grid">
        <div>
          <p class="section-label">会社について</p><h2
            id="company-title"
            class="section-heading"
          >
            沖縄・那覇から、<br />地域とともに。
          </h2><a
            class="text-link"
            href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(company.address)}`}
            target="_blank"
            rel="noopener noreferrer"
            >Googleマップで見る <Icon name="external" size={16} /></a>
        </div><dl class="company-info">
          <div><dt>会社名</dt><dd>{company.legalName}</dd></div><div>
            <dt>設立</dt><dd>2000年1月</dd>
          </div><div>
            <dt>所在地</dt><dd>
              〒{company.postalCode}<br />{company.address}
            </dd>
          </div><div>
            <dt>事業内容</dt><dd>
              訪問介護 / 居宅介護支援 / 計画相談支援<br />ツアーナース /
              介護タクシー / 人材派遣・紹介
            </dd>
          </div><div>
            <dt>採用のご相談</dt><dd>
              <a href="#reserve">説明会・見学の相談</a>
            </dd>
          </div>
        </dl>
      </div>
    </section>
  </main>
  <Footer />
  <div class="mobile-contact">
    <span>まずは、話すところから。</span><Button href="#reserve"
      >説明会・見学の相談</Button>
  </div>
  <script>
    import "../scripts/recruit";
  </script>
</Layout>
