---
import Layout from "../layouts/Layout.astro";
import Brand from "@okinawa-care/ui/Brand.astro";
import Button from "@okinawa-care/ui/Button.astro";
---

<Layout title="ページが見つかりません" noindex
  ><main id="main" class="content-container section">
    <Brand /><h1 class="section-heading mt-16 mb-6">
      ページが見つかりませんでした。
    </h1><p class="mb-8">
      URLをご確認いただくか、採用サイトのトップページからお探しください。
    </p><Button href="/">採用サイトへ戻る</Button>
  </main></Layout
>
