import Button from '@okinawa-care/ui/Button.astro';
---
<Layout title="ページが見つかりません" noindex><main id="main" class="container section"><Brand /><h1 class="section-heading" style="margin: 64px 0 24px">ページが見つかりませんでした。</h1><p style="margin-bottom: 32px">URLをご確認いただくか、採用サイトのトップページからお探しください。</p><Button href="/">採用サイトへ戻る</Button></main></Layout>
