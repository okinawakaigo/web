---
import Layout from "../layouts/Layout.astro";
import Brand from "@okinawa-care/ui/Brand.astro";
import Button from "@okinawa-care/ui/Button.astro";
import SelectField from "@okinawa-care/ui/SelectField.astro";
const colors = [
  { name: "深緑", token: "primary", className: "bg-primary" },
  { name: "文字", token: "ink", className: "bg-ink" },
  { name: "白", token: "paper", className: "bg-paper" },
  { name: "葉の陰", token: "mist", className: "bg-mist" },
  { name: "砂", token: "sand", className: "bg-sand" },
  { name: "陽だまり", token: "sun", className: "bg-sun" },
];
---

<Layout title="デザインガイド" noindex>
  <main id="main" class="content-container section guide">
    <Brand /><p class="guide-label">デザインガイド · 2026年9月 初版</p>
    <h1 class="section-heading">人を想う。自分も、大切にする。</h1><p>
      沖縄の暮らしと、働く人の穏やかな日常。余白、自然な写真、読みやすい文字で、相談しやすい距離感をつくります。
    </p>
    <h2>色</h2><div class="swatches">
      {
        colors.map((color) => (
          <div>
            <>
              <span class={color.className} />
              <strong>{color.name}</strong>
              <small>{color.token}</small>
            </>
          </div>
        ))
      }
    </div><p>
      CTAとリンクは深緑。長文は濃い緑の文字。黄は旅行の支援など、楽しみを伝える場面に限定。薄い面に白文字は重ねません。
    </p>
    <h2>文字</h2><div class="type-samples">
      <p class="display-sample">誰かの毎日も、あなたの毎日も。</p><p>
        見出し：Noto Serif JP 500。大見出しは画面幅に応じて拡縮。
      </p><p>
        本文：Noto Sans JP 400 / 14・16px /
        行高1.95・2.2。補足12px、ラベル13px、短い注記10px。
      </p><p class="latin-sample">Okinawa, our home. 098-882-1156</p><p>
        欧文・電話番号：DM Sans 400–500
      </p>
    </div>
    <h2>余白とレイアウト</h2><p>
      4pxを基本単位に、8 / 12 / 16 / 24 / 32 / 48 /
      64pxを使用。コンテンツは最大1184px、スマホ左右24px。見出し・本文は左揃え。写真は個別の比率で扱い、一覧に必要のないカードは作りません。
    </p>
    <h2>ボタンと操作</h2><div class="button-samples">
      <Button href="/#reserve">説明会・見学の相談</Button><Button
        href="/#jobs"
        variant="outline">仕事を知る</Button>
    </div><p>
      主ボタンは深緑の塗り、補助ボタンは輪郭線。標準のボタン・入力欄は高さ56px、モバイル固定ボタンは48px。操作部品の角丸6px。相談パネルは角丸16px。キーボードフォーカスを表示し、常時動く装飾は使いません。
    </p>
    <div class="max-w-form mt-6">
      <SelectField id="guide-select" label="入力欄の見本"
        ><option>説明会・見学の相談</option></SelectField
      >
      <SelectField id="guide-select-disabled" label="受付準備中の見本" disabled
        ><option>受付準備中</option></SelectField
      >
      <Button
        as="button"
        type="button"
        disabled
        icon={false}
        class="w-full mt-6">受付準備中</Button
      >
    </div>
    <h2>写真と言葉</h2><p>
      ヒーローは当初の大きな写真1枚。PCは左にコピー、右に縦長の角丸写真、スマホは縦積みです。会社の雰囲気は、本文を読み進めながら仕事・相談・職員紹介の写真で伝える方針です。
    </p><p>
      顔の見える実際の活動写真を優先。現在のヒーローはイメージ写真と明示し、実写へ差し替えます。撮影依頼ページのAI生成画像は構図の参考です。給与、休暇、募集状況は確認済みの情報だけを記載。職員の声は本人の取材と同意を得てから追加します。
    </p><a href="/photo-brief/" class="text-link"
      >画像付きの撮影依頼メモを見る</a
    >
    <p class="guide-footer">
      共通実装：packages/ui　掲載情報：packages/content<br
      />ロゴマークは今回の提案です。正式ロゴを受領したらBrandコンポーネントを差し替えます。
    </p><a href="/" class="text-link">採用ページを開く</a>
  </main>
</Layout>
<style>
  @reference "@okinawa-care/ui/styles.css";
  @layer components {
    .guide {
      @apply max-w-guide text-label;
    }
    .guide-label {
      @apply mt-9 mx-0 mb-4 text-caption text-muted;
    }
    h1 + p {
      @apply mt-5 max-w-intro;
    }
    h2 {
      @apply text-subtitle mt-9 mx-0 mb-5;
    }
    .swatches {
      @apply grid grid-cols-6 gap-4 mb-5;
    }
    .swatches span {
      @apply block border border-solid border-line rounded-small;
      height: 65px;
    }
    .swatches strong,
    .swatches small {
      @apply block text-caption mt-2;
    }
    .swatches small {
      @apply mt-0;
    }
    .display-sample {
      @apply font-medium text-headline font-display leading-heading;
    }
    .latin-sample {
      @apply font-normal text-subheading font-latin leading-heading mt-3;
    }
    .button-samples {
      @apply flex flex-wrap gap-4 mb-4;
    }
    .guide-footer {
      @apply mt-10 border-t border-solid border-line pt-5 text-caption text-muted;
    }
    @media (width < theme(--breakpoint-sm)) {
      .swatches {
        @apply grid-cols-3;
      }
    }
    @media print {
      .guide {
        @apply p-0 w-full text-micro;
      }
      h2 {
        @apply mt-5 mx-0 mb-3 text-body;
      }
      .guide-label {
        @apply mt-4;
      }
      .guide .section-heading {
        @apply text-subheading;
      }
      .swatches span {
        height: 40px;
        print-color-adjust: exact;
      }
      .guide-footer {
        @apply mt-5;
      }
      .button-samples :global(.button) {
        @apply py-2 px-4;
        min-height: 38px;
        print-color-adjust: exact;
      }
      .text-link {
        @apply hidden;
      }
    }
  }
</style>
